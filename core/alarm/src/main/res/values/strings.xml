<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Notification channels (Settings › Notifications › Alarm Clock) -->
    <string name="engine_channel_alarms_name">Ringing alarms</string>
    <string name="engine_channel_alarms_desc">Shows the alarm full screen while it rings, also on the lock screen.</string>
    <string name="engine_channel_upcoming_name">Upcoming alarms</string>
    <string name="engine_channel_upcoming_desc">A reminder shortly before an alarm rings, with a button to turn it off in advance.</string>
    <string name="engine_channel_snoozed_name">Snoozed alarms</string>
    <string name="engine_channel_snoozed_desc">Shows when a snoozed alarm will ring again.</string>
    <string name="engine_channel_missed_name">Missed and stopped alarms</string>
    <string name="engine_channel_missed_desc">Tells you when an alarm could not ring, stopped by itself or had to be set again.</string>
    <string name="engine_channel_guard_name">Alarm guard</string>
    <string name="engine_channel_guard_desc">Ongoing notification of the optional guard that keeps alarms reliable.</string>
    <string name="engine_channel_timers_name">Finished timers</string>
    <string name="engine_channel_timers_desc">Shows a timer when it reaches zero.</string>
    <string name="engine_channel_awake_name">Awake check</string>
    <string name="engine_channel_awake_desc">Asks whether you are really awake a few minutes after you turn off an alarm.</string>
    <string name="engine_channel_sunrise_name">Sunrise</string>
    <string name="engine_channel_sunrise_desc">Gradually brightens the screen before a sunrise alarm.</string>

